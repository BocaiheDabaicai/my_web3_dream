# ---------------------------------------------------------------
# Copy this file to .env at the repository root.
# Never commit .env — it may contain API keys.
# ---------------------------------------------------------------

# ---- Chain data (C0) ----
# Ethereum mainnet = 1, Sepolia = 11155111
CHAIN_ID=1
# Comma-separated list. The first healthy endpoint wins.
RPC_URLS=https://ethereum-rpc.publicnode.com,https://1rpc.io/eth
REQUEST_TIMEOUT_SECONDS=10

# ---- Indexed chain data (C3) ----
# Etherscan is not reachable from this network; Routescan is the fallback.
# ROUTESCAN_BASE_URL=https://api.routescan.io/v2/network/mainnet/evm/1
# ROUTESCAN_TESTNET_BASE_URL=https://api.routescan.io/v2/network/testnet/evm/11155111

# ---- PostgreSQL (C3) ----
# DATABASE_URL=postgresql+asyncpg://onchain:onchain@localhost:5432/onchain

# ---- Agent (C5) ----
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
